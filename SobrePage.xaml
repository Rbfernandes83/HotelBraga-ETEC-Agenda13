<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HotelBraga.SobrePage"
    Title="Sobre"
    BackgroundColor="#F5F7FA">

    <ScrollView>
        <VerticalStackLayout
            Padding="25"
            Spacing="18">

            <Label
                Text="HOTEL BRAGA"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#142D4E"
                HorizontalOptions="Center" />

            <Label
                Text="SOBRE O APLICATIVO"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="#D4AF37"
                HorizontalOptions="Center" />

            <Frame
                BackgroundColor="White"
                BorderColor="#D4AF37"
                CornerRadius="15"
                Padding="20">

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="Hotel Braga - Reservas"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="#142D4E"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Aplicativo desenvolvido para simular reservas de hospedagem, utilizando componentes de interface gráfica e programação em C#."
                        FontSize="15"
                        TextColor="#444444"
                        HorizontalTextAlignment="Center" />

                    <BoxView
                        HeightRequest="1"
                        Color="#D4AF37" />

                    <Label
                        Text="DESENVOLVEDOR"
                        FontAttributes="Bold"
                        TextColor="#142D4E" />

                    <Label
                        Text="Rogério Braga Fernandes"
                        FontSize="17" />

                    <Label
                        Text="CURSO"
                        FontAttributes="Bold"
                        TextColor="#142D4E" />

                    <Label
                        Text="Técnico em Desenvolvimento de Sistemas - ETEC" />

                    <Label
                        Text="DISCIPLINA"
                        FontAttributes="Bold"
                        TextColor="#142D4E" />

                    <Label
                        Text="Desenvolvimento de Sistemas II - Agenda 13" />

                    <Label
                        Text="ANO DE DESENVOLVIMENTO"
                        FontAttributes="Bold"
                        TextColor="#142D4E" />

                    <Label Text="2026" />

                    <Label
                        Text="TECNOLOGIAS"
                        FontAttributes="Bold"
                        TextColor="#142D4E" />

                    <Label Text="C# | XAML | .NET MAUI" />

                </VerticalStackLayout>
            </Frame>

            <Button
                Text="Voltar"
                BackgroundColor="#142D4E"
                TextColor="White"
                CornerRadius="12"
                Clicked="Voltar_Clicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
